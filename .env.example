# =====================================================================
#  Website Paroki St. Yoseph Bambu Pemali
#  Salin file ini menjadi .env lalu sesuaikan. Panduan hosting: docs/DEPLOY.md
# =====================================================================

APP_NAME="Paroki St. Yoseph Bambu Pemali"
# local = komputer pengembang, production = hosting
APP_ENV=local
# Isi dengan: php artisan key:generate
APP_KEY=
# WAJIB false di hosting (production) agar detail error tidak tampil ke publik
APP_DEBUG=true
# Alamat website tanpa garis miring di akhir, contoh di hosting: https://parokibambupemali.org
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jayapura
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Di hosting cukup "error" agar file log tidak cepat membesar
LOG_LEVEL=debug

# Database MySQL (lokal: Laragon). Di cPanel nama database & user biasanya berawalan nama akun, contoh: akun_paroki
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=SI_GEREJA_BAMPEL
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Foto & PDF yang diunggah admin disimpan di storage/app/public (butuh: php artisan storage:link)
FILESYSTEM_DISK=public
# URL file upload. Default "/storage" (relatif, cocok bila website di root domain).
# Bila website dipasang di subfolder, contoh domain.com/paroki, isi: /paroki/storage
# FILESYSTEM_PUBLIC_URL=/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email untuk fitur "Lupa kata sandi" admin.
# Lokal: log (email ditulis ke storage/logs). Hosting: smtp dengan akun email dari cPanel.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sekretariat@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
